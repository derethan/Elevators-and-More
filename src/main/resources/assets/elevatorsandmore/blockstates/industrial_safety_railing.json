{
  "multipart": [
    {
      "when": { "north": "true" },
      "apply": { "model": "elevatorsandmore:block/industrial_safety_railing", "y": 0 }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "elevatorsandmore:block/industrial_safety_railing", "y": 90 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "elevatorsandmore:block/industrial_safety_railing", "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "elevatorsandmore:block/industrial_safety_railing", "y": 270 }
    },
    {
      "when": { "pedestal": "true" },
      "apply": { "model": "elevatorsandmore:block/industrial_control_pedestal" }
    }
  ]
}
